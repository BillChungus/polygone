{
  "manifest_version": 3,
  "name": "Poly Check",
  "version": "0.1.0",
  "description": "Shows how much plastic (polyester, nylon, acrylic, spandex and more) is in a garment's fabric, right on the product page.",
  "minimum_chrome_version": "102",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "action": {
    "default_title": "Poly Check",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/parser.js",
        "src/detect.js",
        "src/report.js",
        "src/badge.js",
        "src/settings.js",
        "src/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
