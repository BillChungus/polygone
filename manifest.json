{
  "manifest_version": 3,
  "name": "Poly Check",
  "version": "0.1.0",
  "description": "Shows how much polyester a garment contains, right on the product page.",
  "minimum_chrome_version": "102",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/parser.js",
        "src/detect.js",
        "src/report.js",
        "src/badge.js",
        "src/settings.js",
        "src/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Poly Check",
    "default_popup": "popup/popup.html"
  }
}
